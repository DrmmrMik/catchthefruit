{
  "name": "catch-the-fruit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "2D educational arcade PWA teaching phonics, morphology, and vocabulary for 2nd grade students",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build:assets": "python3 scripts/generate_atlas.py public/assets && python3 scripts/generate_pwa_assets.py public",
    "verify:bsa": "~/.build-standards/bin/bsa verify ."
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "phaser": "^4.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@fontsource-variable/lexend": "^5.3.0",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
